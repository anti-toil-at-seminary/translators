<script>
  document.addEventListener('DOMContentLoaded', function () {
    const trackingButtons = document.querySelectorAll('.btn-tracking');

    trackingButtons.forEach(button => {
      button.addEventListener('click', function () {
        const lineItemId = this.dataset.id;

        fetch(`/orders/${lineItemId}/split-shipment-info/`)
          .then(response => response.json())
          .then(shipments => {
            let html = '';

            shipments.forEach(shipment => {
              if (shipment.quantity_shipped && shipment.tracking_number) {
                html += `<div>
                         ${shipment.quantity_shipped} of ${shipment.quantity} items shipped
                         ${shipment.shipped_date}
                         <span class="ph-no-capture"><a href="${shipment.narvar_order_url}" target="_blank" class="underline">${shipment.tracking_number}</a></span>
                       </div>`;
              }
            });

            this.outerHTML = html;
          });
      });
    });
  });
</script>

